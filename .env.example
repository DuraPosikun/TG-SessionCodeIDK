# Получи на https://my.telegram.org (API development tools)
API_ID=123456
API_HASH=abcdef01234567890abcdef012345678

# Токен от @BotFather
BOT_TOKEN=1234567890:AAAbbbcccdddeeefffggghhhiii

# (необязательно) через ; или , — кто может пользоваться ботом.
# Пусто = бот для всех
ALLOWED_IDS=

# Папка для данных
DATA_DIR=data

# (необязательно) Автовход при старте бота:
# твой chat id — куда придёт «✅ Вход успешный» и ВСЕ сообщения от Telegram (777000)
ADMIN_ID=
# строка сессии Telethon (или путь к session.json / *.session)
STARTUP_SESSION=
# или путь к папке tdata / архиву с ней (если STARTUP_SESSION пуст)
STARTUP_TDATA=
